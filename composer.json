{
  "name": "jdiassdev/laravel-types-gen",
  "description": "Generate TypeScript types from Laravel FormRequests and API Resources.",
  "keywords": [
    "laravel",
    "typescript",
    "types",
    "generator",
    "formrequest",
    "api-resource"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/jdiassdev/laravel-types-gen",
  "authors": [
    {
      "name": "João Dias",
      "email": "jdiassdev@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/filesystem": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Jdiassdev\\LaravelTypesGen\\": "src/"
    }
  },
 "autoload-dev": {
  "psr-4": {
    "Jdiassdev\\LaravelTypesGen\\Tests\\": "Tests/"
  }
},
  "extra": {
    "laravel": {
      "providers": [
        "Jdiassdev\\LaravelTypesGen\\LaravelTypesGenServiceProvider"
      ]
    }
  },
"require-dev": {
      "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^9.0|^10.0"
},
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
